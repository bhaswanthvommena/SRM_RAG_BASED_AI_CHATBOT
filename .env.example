# Database
# Local Docker: postgresql://srmap:srmap@localhost:5432/srmap_rag
# Laptop (no IPv6): Supabase session pooler
# Cloud Run: Supabase transaction pooler, port 6543
DATABASE_URL=postgresql://srmap:srmap@localhost:5432/srmap_rag

# Google Gemini — prefer separate keys (different AI Studio accounts) to split quota
# https://aistudio.google.com/apikey
GEMINI_CHAT_API_KEY=
GEMINI_EMBEDDING_API_KEY=
# Optional legacy fallback if either key above is empty
GEMINI_API_KEY=

# Embedding provider: gemini | local
# Never mix models in one index.
# Local BGE:  prepare-local-index  → EMBEDDING_PROVIDER=local  EMBEDDING_DIMS=384
# Gemini:     prepare-gemini-index → EMBEDDING_PROVIDER=gemini EMBEDDING_DIMS=768
EMBEDDING_PROVIDER=gemini
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBED_BATCH_SIZE=8

# Models (confirm names at https://ai.google.dev/gemini-api/docs/models)
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
EMBEDDING_DIMS=768

# Site
SITE_BASE_URL=https://www.srmap.edu.in
CRAWL_USER_AGENT=SRMAP-RAG-Bot/0.1 (+research; contact=local-dev)
CRAWL_RPS=1.5
CRAWL_CONCURRENCY=4

# Paths
DATA_DIR=./data
MANIFEST_PATH=./data/manifest.jsonl

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
